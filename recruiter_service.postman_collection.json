{
    "info": {
        "_postman_id": "recruiter-service-tag-collection",
        "name": "Recruiter Service API - Tags Only",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Tags",
            "item": [
                {
                    "name": "Create Tag",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "x-tenant-id",
                                "value": "{{tenantId}}",
                                "type": "text"
                            },
                            {
                                "key": "x-user-id",
                                "value": "{{userId}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Senior Developer\",\n    \"color\": \"COLOR_ID_HERE\",\n    \"entityType\": \"candidate\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/tags",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "tags"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Get Tags",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "x-tenant-id",
                                "value": "{{tenantId}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/tags?entityType=candidate",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "tags"
                            ],
                            "query": [
                                {
                                    "key": "entityType",
                                    "value": "candidate"
                                }
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Update Tag (Patch)",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "x-tenant-id",
                                "value": "{{tenantId}}",
                                "type": "text"
                            },
                            {
                                "key": "x-user-id",
                                "value": "{{userId}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "[\n    { \"op\": \"replace\", \"path\": \"/name\", \"value\": \"Lead Developer\" }\n]",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/tags/:id",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "tags",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "TAG_ID_HERE"
                                }
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Delete Tag",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "x-tenant-id",
                                "value": "{{tenantId}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/tags/:id",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "tags",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "TAG_ID_HERE"
                                }
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Tag Colors",
                    "item": [
                        {
                            "name": "Get Available Colors",
                            "request": {
                                "method": "GET",
                                "header": [
                                    {
                                        "key": "x-tenant-id",
                                        "value": "{{tenantId}}",
                                        "type": "text"
                                    }
                                ],
                                "url": {
                                    "raw": "{{baseUrl}}/tags/colors?entityType=candidate",
                                    "host": [
                                        "{{baseUrl}}"
                                    ],
                                    "path": [
                                        "tags",
                                        "colors"
                                    ],
                                    "query": [
                                        {
                                            "key": "entityType",
                                            "value": "candidate"
                                        }
                                    ]
                                }
                            },
                            "response": []
                        },
                        {
                            "name": "Create Tag Color",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "x-tenant-id",
                                        "value": "{{tenantId}}",
                                        "type": "text"
                                    },
                                    {
                                        "key": "x-user-id",
                                        "value": "{{userId}}",
                                        "type": "text"
                                    }
                                ],
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"color\": \"#3498db\",\n    \"entityType\": \"candidate\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                },
                                "url": {
                                    "raw": "{{baseUrl}}/tags/colors",
                                    "host": [
                                        "{{baseUrl}}"
                                    ],
                                    "path": [
                                        "tags",
                                        "colors"
                                    ]
                                }
                            },
                            "response": []
                        },
                        {
                            "name": "Delete Color",
                            "request": {
                                "method": "DELETE",
                                "header": [
                                    {
                                        "key": "x-tenant-id",
                                        "value": "{{tenantId}}",
                                        "type": "text"
                                    }
                                ],
                                "url": {
                                    "raw": "{{baseUrl}}/tags/colors/:id",
                                    "host": [
                                        "{{baseUrl}}"
                                    ],
                                    "path": [
                                        "tags",
                                        "colors",
                                        ":id"
                                    ],
                                    "variable": [
                                        {
                                            "key": "id",
                                            "value": "COLOR_ID_HERE"
                                        }
                                    ]
                                }
                            },
                            "response": []
                        }
                    ]
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3002/api/v1"
        },
        {
            "key": "tenantId",
            "value": "ENTER_TENANT_ID_HERE"
        },
        {
            "key": "userId",
            "value": "ENTER_USER_ID_HERE"
        }
    ]
}